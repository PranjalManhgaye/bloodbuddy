# BloodBuddy Environment Configuration
# Copy to .env and adjust values

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/bloodbuddy.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication mode: demo | firebase
AUTH_MODE=demo
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=1440

# Firebase (only when AUTH_MODE=firebase)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# AI Provider: demo | ollama
AI_PROVIDER=demo
# Ollama settings (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# Notifications: demo (manual WhatsApp/SMS link generation) | twilio | whatsapp_business
NOTIFICATION_PROVIDER=demo
# Twilio configuration (when NOTIFICATION_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WhatsApp Business Cloud API (when NOTIFICATION_PROVIDER=whatsapp_business)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Frontend (build-time only, no secrets)
VITE_API_BASE_URL=http://localhost:8000
